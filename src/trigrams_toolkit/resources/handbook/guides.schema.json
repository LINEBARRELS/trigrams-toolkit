{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:harness:guides",
  "title": "Work guide headers and resource manifests",
  "$defs": {
    "guideId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:(?:workbook:[a-z][a-z0-9-]*|principle:[a-z][a-z0-9]*(?:-[a-z0-9]+)*/[a-z][a-z0-9]*(?:-[a-z0-9]+)*)$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "header": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "resourceId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*:workbook:[a-z][a-z0-9-]*$"
        },
        "includes": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/guideId"
          }
        }
      }
    },
    "extensionManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "extension",
        "version",
        "resourceRoots",
        "install"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "extension": {
          "allOf": [
            {
              "$ref": "urn:harness:common#/$defs/token"
            },
            {
              "not": {
                "enum": [
                  "core",
                  "project"
                ]
              }
            }
          ]
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "resourceRoots": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "urn:harness:common#/$defs/path"
          }
        },
        "artifactTypes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "urn:harness:common#/$defs/kindId"
          }
        },
        "relationTypes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relationType"
          }
        },
        "install": {
          "$ref": "#/$defs/installEntries"
        }
      }
    },
    "resourceManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "source",
        "version",
        "resourceRoots",
        "install"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "source": {
          "$ref": "urn:harness:common#/$defs/token"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "resourceRoots": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "urn:harness:common#/$defs/path"
          }
        },
        "artifactTypes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "urn:harness:common#/$defs/kindId"
          }
        },
        "relationTypes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relationType"
          }
        },
        "install": {
          "$ref": "#/$defs/installEntries"
        }
      }
    },
    "installEntries": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "target"
        ],
        "properties": {
          "source": {
            "$ref": "urn:harness:common#/$defs/path"
          },
          "target": {
            "$ref": "urn:harness:common#/$defs/path"
          }
        }
      }
    },
    "package": {
      "oneOf": [
        {
          "$ref": "#/$defs/extensionManifest"
        },
        {
          "$ref": "#/$defs/resourceManifest"
        }
      ]
    },
    "relationType": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "fromKinds",
        "toKinds",
        "maxOutgoing",
        "maxIncoming",
        "acyclic"
      ],
      "properties": {
        "kind": {
          "$ref": "urn:harness:common#/$defs/kindId"
        },
        "fromKinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "urn:harness:common#/$defs/kindId"
          }
        },
        "toKinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "urn:harness:common#/$defs/kindId"
          }
        },
        "maxOutgoing": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "maxIncoming": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "acyclic": {
          "type": "boolean"
        }
      }
    },
    "principleHeader": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    }
  }
}
