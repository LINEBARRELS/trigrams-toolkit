{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:harness:common",
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "token": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "localId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "entityId": {
      "type": "string",
      "pattern": "^(artifact|module|feature)_[A-Za-z0-9_-]+$"
    },
    "artifactId": {
      "type": "string",
      "pattern": "^artifact_[A-Za-z0-9_-]+$"
    },
    "resourceId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:(?:workbook:[a-z][a-z0-9-]*|principle:[a-z][a-z0-9]*(?:-[a-z0-9]+)*/[a-z][a-z0-9]*(?:-[a-z0-9]+)*)$"
    },
    "kindId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))(?!.*//)(?!.*[\\\\:*?\"<>|\\u0000-\\u001f])(?!.*[. ](?:/|$))[^/]+(?:/[^/]+)*$"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "kind": {
          "enum": [
            "human",
            "agent",
            "service"
          ]
        }
      }
    },
    "fileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "root",
        "path"
      ],
      "properties": {
        "kind": {
          "const": "file"
        },
        "root": {
          "enum": [
            "project",
            "plan"
          ]
        },
        "path": {
          "$ref": "#/$defs/path"
        }
      }
    },
    "ref": {
      "oneOf": [
        {
          "$ref": "#/$defs/fileRef"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ],
          "properties": {
            "kind": {
              "const": "artifact"
            },
            "id": {
              "$ref": "#/$defs/artifactId"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ],
          "properties": {
            "kind": {
              "const": "resource"
            },
            "id": {
              "$ref": "#/$defs/resourceId"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "repository",
            "commit",
            "path"
          ],
          "properties": {
            "kind": {
              "const": "git"
            },
            "repository": {
              "$ref": "#/$defs/text"
            },
            "commit": {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
            },
            "path": {
              "$ref": "#/$defs/path"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "uri",
            "version"
          ],
          "properties": {
            "kind": {
              "const": "external"
            },
            "uri": {
              "type": "string",
              "format": "uri"
            },
            "version": {
              "$ref": "#/$defs/text"
            }
          }
        }
      ]
    },
    "refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/localId"
      }
    },
    "texts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "errorCode": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "current",
        "conflicts",
        "recovery"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/errorCode"
        },
        "message": {
          "$ref": "#/$defs/text"
        },
        "current": {
          "type": [
            "object",
            "null"
          ]
        },
        "conflicts": {
          "$ref": "#/$defs/texts"
        },
        "recovery": {
          "$ref": "#/$defs/text"
        }
      }
    }
  }
}
