{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:harness:state-cli",
  "$defs": {
    "absolutePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!.*\\u0000)(?:/|[A-Za-z]:[\\\\/]|[\\\\/]{2}[^\\\\/]+[\\\\/][^\\\\/]+)"
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "error"],
      "properties": {
        "ok": { "const": false },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "message": { "type": "string", "minLength": 1 },
            "details": {}
          }
        }
      }
    },
    "moduleView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "name"],
      "properties": {
        "id": { "$ref": "urn:harness:state#/$defs/module/properties/id" },
        "kind": { "const": "core:module" },
        "name": { "$ref": "urn:harness:state#/$defs/module/properties/name" }
      }
    },
    "featureView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "name", "moduleId"],
      "properties": {
        "id": { "$ref": "urn:harness:state#/$defs/feature/properties/id" },
        "kind": { "const": "core:feature" },
        "name": { "$ref": "urn:harness:state#/$defs/feature/properties/name" },
        "moduleId": { "$ref": "urn:harness:state#/$defs/feature/properties/moduleId" }
      }
    },
    "artifactView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "featureIds"],
      "properties": {
        "id": { "$ref": "urn:harness:state#/$defs/artifact/properties/id" },
        "kind": { "$ref": "urn:harness:state#/$defs/artifact/properties/kind" },
        "title": { "$ref": "urn:harness:state#/$defs/artifact/properties/title" },
        "moduleId": { "$ref": "urn:harness:state#/$defs/artifact/properties/moduleId" },
        "featureIds": { "$ref": "urn:harness:state#/$defs/artifact/properties/featureIds" }
      }
    },
    "entityView": {
      "oneOf": [
        { "$ref": "#/$defs/moduleView" },
        { "$ref": "#/$defs/featureView" },
        { "$ref": "#/$defs/artifactView" }
      ]
    },
    "locatedArtifactView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "featureIds", "path"],
      "properties": {
        "id": { "$ref": "#/$defs/artifactView/properties/id" },
        "kind": { "$ref": "#/$defs/artifactView/properties/kind" },
        "title": { "$ref": "#/$defs/artifactView/properties/title" },
        "moduleId": { "$ref": "#/$defs/artifactView/properties/moduleId" },
        "featureIds": { "$ref": "#/$defs/artifactView/properties/featureIds" },
        "path": { "$ref": "#/$defs/absolutePath" }
      }
    },
    "locateResult": {
      "oneOf": [
        { "$ref": "#/$defs/moduleView" },
        { "$ref": "#/$defs/featureView" },
        { "$ref": "#/$defs/locatedArtifactView" }
      ]
    },
    "listResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items"],
      "properties": {
        "items": { "type": "array", "items": { "$ref": "#/$defs/entityView" } }
      }
    },
    "queryRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "from", "to", "source"],
      "properties": {
        "kind": { "$ref": "urn:harness:state#/$defs/relation/properties/kind" },
        "from": { "$ref": "urn:harness:state#/$defs/relation/properties/from" },
        "to": { "$ref": "urn:harness:state#/$defs/relation/properties/to" },
        "source": { "enum": ["feature", "document", "relation"] }
      }
    },
    "relatedResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "relations"],
      "properties": {
        "items": { "type": "array", "items": { "$ref": "#/$defs/locateResult" } },
        "relations": { "type": "array", "items": { "$ref": "#/$defs/queryRelation" } }
      }
    },
    "locateResponse": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["ok", "data"],
          "properties": { "ok": { "const": true }, "data": { "$ref": "#/$defs/locateResult" } }
        },
        { "$ref": "#/$defs/failure" }
      ]
    },
    "listResponse": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["ok", "data"],
          "properties": { "ok": { "const": true }, "data": { "$ref": "#/$defs/listResult" } }
        },
        { "$ref": "#/$defs/failure" }
      ]
    },
    "relatedResponse": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["ok", "data"],
          "properties": { "ok": { "const": true }, "data": { "$ref": "#/$defs/relatedResult" } }
        },
        { "$ref": "#/$defs/failure" }
      ]
    },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ok",
            "data"
          ],
          "properties": {
            "ok": {
              "const": true
            },
            "data": {
              "type": "object"
            }
          }
        },
        {
          "$ref": "#/$defs/failure"
        }
      ]
    },
    "emptyInput": {
      "type": "object",
      "additionalProperties": false
    },
    "moduleInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "featureInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "module": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "artifactInput": {
      "type": "object",
      "additionalProperties": false,
      "dependentRequired": { "feature": ["module"] },
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "module": {
          "type": "string",
          "pattern": "^module_[A-Za-z0-9_-]+$",
          "description": "Replace ownership with this Module and the supplied feature list; omitted ownership retains registered values."
        },
        "feature": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^feature_[A-Za-z0-9_-]+$" },
          "description": "Values of repeated --feature options; requires module in the same command."
        }
      }
    },
    "idInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "listInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "relatedInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "enum": [
            "both",
            "incoming",
            "outgoing"
          ]
        }
      }
    },
    "relateInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "kind",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "description": "Relation type supplied as the RELATION positional argument."
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "remove": {
          "type": "boolean"
        }
      }
    },
    "registerResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity",
        "changed"
      ],
      "properties": {
        "entity": {
          "$ref": "urn:harness:state#/$defs/entity"
        },
        "changed": {
          "type": "boolean"
        }
      }
    }
  }
}
